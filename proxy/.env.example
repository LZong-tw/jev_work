# Your real TypeSafe API key (apikey_...). Only the proxy ever sees it.
JEV_API_KEY=apikey_your_key_here

# Upstream (default is the official Jev API)
UPSTREAM_BASE_URL=https://api.typesafe.ai

# Used for per-key budgets: TypeSafe charges US$42 per billion input tokens
INPUT_PRICE_PER_MILLION=0.042
UPSTREAM_TIMEOUT_MS=30000

PORT=8787
KEYS_FILE=keys.json
USAGE_FILE=usage.json
# LOG_FILE=proxy.log

# Bearer token for /admin/usage and /admin/keys
ADMIN_TOKEN=change-me-to-a-long-random-string

# Limits for keys that do not set their own
DEFAULT_RPM=60
DEFAULT_DAILY_REQUESTS=2000
# DEFAULT_MAX_COST_USD=1.00

# Day boundary for daily limits
TIME_ZONE=Asia/Taipei

# 1 = answer with a local fake Jev (no upstream key, no cost). For rehearsal only.
MOCK_UPSTREAM=0
